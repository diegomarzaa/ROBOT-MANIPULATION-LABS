<?xml version='1.0' encoding='UTF-8'?>
<programList xmlns="ProgramNameSpace">
  <program name="start" public="false">
    <description>Level 3: four taught piston slots with tool presence sensing and bounded assembly.</description>
    <paramSection/>
    <localSection>
      <local name="poseIndex" type="num" size="1"/>
      <local name="approachPose" type="point" size="1"/>
      <local name="placePose" type="point" size="1"/>
      <local name="pistonApproach" type="point" size="1"/>
      <local name="pickPose" type="point" size="1"/>
      <local name="checkPose" type="point" size="1"/>
      <local name="checkApproach" type="point" size="1"/>
    </localSection>
    <source>
      <code>begin
  // ============================================================
  // LEVEL 3: ALIMENTAR, MONTAR Y COLOCAR CUATRO CONJUNTOS
  // ============================================================
  // Adaptacion Level 2 de la estructura de Isma; originales preservados.
  // Lab2B (Level 1) y Lab2B_Level2 permanecen sin modificar.
  // Matriz VACIA. Los huecos sin piston se detectan y se omiten.
  // simulation=true: sensores manuales, sin acceso a pines.
  // simulation=false: bIn2/14/15, bOut10 y pinza valve1.
  userPage()
  cls()
  putln("Lab2B_L3 - Four assemblies - empty matrix required")
  physicalRun = !simulation
  placedCount = 0
  partIndex = 0
  pistonIndex = 0
  pistonFound = false
  pistonChecked = false
  cycleStep = 0
  feederExtend = false
  ioReady = false

  // ============================================================
  // COMPROBAR ALTURAS DE MATRIZ SIN MOVER NI ACCIONAR SALIDAS
  // ============================================================
  // Parejas 0/1, 2/3, 4/5, 6/7: par=approach, impar=deposito.
  // J3 es un ANGULO, no una altura. Calculamos Z del TCP lateral.
  // Esto comprueba altura, no colisiones, alineacion o alcance del trayecto.
  for poseIndex = 0 to 3
    approachPose = jointToPoint(tLateral, world, jMatrix[2*poseIndex])
    placePose = jointToPoint(tLateral, world, jMatrix[2*poseIndex+1])
    putln("Matrix slot (0..3):")
    putln(poseIndex)
    putln("Approach Z (mm):")
    putln(approachPose.trsf.z)
    putln("Place Z (mm):")
    putln(placePose.trsf.z)
    if approachPose.trsf.z &lt;= placePose.trsf.z
      putln("ERROR: approach is not above place; review this matrix pair")
      return
    endIf
  endFor

  // ============================================================
  // CUATRO RECOGIDAS REALES: IMG_3805, 3806, 3807, 3808
  // ============================================================
  // jPistonPick: impares = recogidas ENSENADAS; pares = approaches
  // CALCULADOS aqui (pick + pistonLift en Z world, misma orientacion).
  // jPistonCheck[0..3]: poses de deteccion bIn0 ENSENADAS en el mando
  // (sensor lateral de la pinza). NO se recalculan ni se sobrescriben.
  // jCheckApproach[0..3]: CALCULADOS aqui (check + checkLift en Z world,
  // misma orientacion). Los ceros del DTX son espacio para el resultado.
  // Todo termina antes de crear tareas o mover el robot.
  if pistonLift &lt;= 0 or checkLift &lt;= 0
    putln("ERROR: pistonLift and checkLift must be positive (mm)")
    return
  endIf
  for poseIndex = 0 to 3
    if jPistonPick[2*poseIndex+1].j1 == 0 and jPistonPick[2*poseIndex+1].j2 == 0 and jPistonPick[2*poseIndex+1].j3 == 0 and jPistonPick[2*poseIndex+1].j4 == 0 and jPistonPick[2*poseIndex+1].j5 == 0 and jPistonPick[2*poseIndex+1].j6 == 0
      putln("ERROR: teach piston pick joint; missing piston (0..3):")
      putln(poseIndex)
      return
    endIf
    if jPistonCheck[poseIndex].j1 == 0 and jPistonCheck[poseIndex].j2 == 0 and jPistonCheck[poseIndex].j3 == 0 and jPistonCheck[poseIndex].j4 == 0 and jPistonCheck[poseIndex].j5 == 0 and jPistonCheck[poseIndex].j6 == 0
      putln("ERROR: teach jPistonCheck; missing sensing pose (0..3):")
      putln(poseIndex)
      return
    endIf
    pickPose = jointToPoint(tTip, world, jPistonPick[2*poseIndex+1])
    pistonApproach = pickPose
    pistonApproach.trsf.z = pickPose.trsf.z + pistonLift
    if !pointToJoint(tTip, jPistonPick[2*poseIndex+1], pistonApproach, jPistonPick[2*poseIndex])
      putln("ERROR: no piston approach solution; piston (0..3):")
      putln(poseIndex)
      return
    endIf
    checkPose = jointToPoint(tTip, world, jPistonCheck[poseIndex])
    checkApproach = checkPose
    checkApproach.trsf.z = checkPose.trsf.z + checkLift
    if !pointToJoint(tTip, jPistonCheck[poseIndex], checkApproach, jCheckApproach[poseIndex])
      putln("ERROR: no check approach solution; piston (0..3):")
      putln(poseIndex)
      return
    endIf
    putln("Piston slot (0..3):")
    putln(poseIndex)
    putln("  tTip Z pick / pickAppr / check / checkAppr (mm):")
    putln(pickPose.trsf.z)
    putln(pistonApproach.trsf.z)
    putln(checkPose.trsf.z)
    putln(checkApproach.trsf.z)
    putln("  check - pick XY offset (mm):")
    putln(checkPose.trsf.x - pickPose.trsf.x)
    putln(checkPose.trsf.y - pickPose.trsf.y)
  endFor

  // physicalIO solo escribe el ALIMENTADOR; nunca la pinza.
  if physicalRun
    taskCreate "physicalIO", 10, physicalIO()
    wait(ioReady == true)
    putln("PHYSICAL: real sensors and feeder enabled")
    open(tLateral)
  else
    putln("MANUAL SIMULATION: change sensor bools at the indicated steps")
    delay(tLateral.otime)
  endIf
  movej(jStart[0], tLateral, mNomSpeed)
  waitEndMove()

  // ============================================================
  // SOLO CUATRO CONJUNTOS; NO HAY QUINTA ALIMENTACION
  // ============================================================
  while placedCount &lt; 4
    partIndex = placedCount
    putln("Assembly number (1..4):")
    putln(partIndex+1)
    call feedCylinder()
    call placeCylinder()
    call insertPiston()
    call placeInMatrix()
    // Contar tras soltar y terminar la retirada de la matriz.
    placedCount = placedCount + 1
    putln("Completed matrix slots:")
    putln(placedCount)
    // Volver a la postura inicial SOLO si falta otro conjunto.
    if placedCount &lt; 4
      movej(jStart[0], tLateral, mNomSpeed)
      waitEndMove()
    endIf
  endWhile

  // La matriz llena finaliza aunque bIn2 siga detectando cilindros.
  feederExtend = false
  taskKill("physicalIO")
  if physicalRun
    io:bOut10 = false
  endIf
  ioReady = false
  cycleStep = 100
  putln("100 - Matrix full: 4/4. No further feeding or pickup.")
end
</code>
    </source>
  </program>
</programList>
