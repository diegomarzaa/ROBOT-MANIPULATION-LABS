<?xml version="1.0" encoding="utf-8"?>
<programList xmlns="ProgramNameSpace">
  <program name="start" public="false">
    <description>Level 1: one assembly; shared manual simulation and physical cycle.</description>
    <paramSection />
    <localSection />
    <source>
      <code>begin
  // ============================================================
  // LAB 2B - LEVEL 1: UN CILINDRO, UN PISTON Y RAMPA FINAL
  // ============================================================
  // ANTES de arrancar: simulation=true manual; false robot fisico.
  // Un solo ciclo. Cilindro cargado y piston en jPistonPick[1].
  // La estacion de montaje debe estar vacia al empezar.
  // No alimentamos automaticamente ni buscamos huecos de la bandeja.
  // Joints de las fotos: [0]=aproximacion, [1]=trabajo, PROVISIONAL.
  // Excepcion: jStart contiene dos posturas iniciales; solo se usa [0].
  userPage()
  cls()

  // Fijamos el modo hasta el siguiente arranque, como en Lab2A_new.
  // La tarea anterior se elimina si existe; no escribe ninguna salida.
  taskKill("physicalIO")
  physicalRun = !simulation
  cycleStep = 0
  ioReady = false
  gripperOpen = true

  // ============================================================
  // 0. CONECTAR E/S SOLO EN FISICO Y ABRIR LA PINZA
  // ============================================================
  // cylinderPresent: lectura de bIn2, presencia en el dispensador.
  // gripperOpen: ORDEN a bOut0; true=abrir, false=cerrar.
  // No es un sensor de agarre. bIn0 tampoco confirma el agarre:
  // detecta pistones delante de la herramienta para Level 3.
  // Los TCP usan toolDummy; toda la salida real pasa por physicalIO.
  if physicalRun
    taskCreate "physicalIO", 10, physicalIO()
    wait(ioReady == true)
    putln("Lab2B - Level 1 - PHYSICAL")
  else
    putln("Lab2B - Level 1 - MANUAL SIMULATION")
  endIf
  delay(tLateral.otime)

  // ============================================================
  // 10. ESPERAR EL CILINDRO PREPARADO
  // ============================================================
  // SIMULACION: TU pones cylinderPresent=true en memoria del emulador.
  // FISICO: physicalIO lee bIn2; no editar el bool a mano.
  // No borramos el sensor ni lo activamos automaticamente al arrancar.
  // wait no tiene timeout y no exige un flanco si ya estaba a true.
  cycleStep = 10
  putln("10 - Wait: cylinderPresent=true (bIn2)")
  wait(cylinderPresent == true)

  // ============================================================
  // 20. RECOGER EL CILINDRO CON EL TCP LATERAL
  // ============================================================
  // movej: traslado articular entre aproximaciones.
  // movel: entrada y retirada rectas del TCP, a velocidad de precision.
  // jointToPoint convierte la joint para movel; no mueve el robot.
  // Usar el mismo TCP en la conversion y en la orden de movimiento.
  // waitEndMove termina cada movimiento antes de accionar la pinza.
  cycleStep = 20
  putln("20 - Pick cylinder - tLateral")
  // startpoint es postura inicial, NO recogida de cilindro.
  movej(jStart[0], tLateral, mNomSpeed)
  waitEndMove()
  movej(jCylinderPick[0], tLateral, mNomSpeed)
  waitEndMove()
  movel(jointToPoint(tLateral, world, jCylinderPick[1]), tLateral, mInsertSpeed)
  waitEndMove()

  // Cerrar y dar el tiempo mecanico guardado en la herramienta (1 s).
  // No hay confirmacion de agarre en el mapa de E/S de esta practica.
  gripperOpen = false
  delay(tLateral.ctime)
  movel(jointToPoint(tLateral, world, jCylinderPick[0]), tLateral, mInsertSpeed)
  waitEndMove()

  // ============================================================
  // 30. DEPOSITAR EL CILINDRO EN LA ESTACION DE MONTAJE
  // ============================================================
  cycleStep = 30
  putln("30 - Place cylinder at assembly station")
  movej(jCylinderPlace[0], tLateral, mNomSpeed)
  waitEndMove()
  movel(jointToPoint(tLateral, world, jCylinderPlace[1]), tLateral, mInsertSpeed)
  waitEndMove()
  gripperOpen = true
  delay(tLateral.otime)
  movel(jointToPoint(tLateral, world, jCylinderPlace[0]), tLateral, mInsertSpeed)
  waitEndMove()

  // ============================================================
  // 40. RECOGER EL PISTON CON EL TCP DE PUNTA
  // ============================================================
  // tTip y tLateral son DOS TCP de LA MISMA PINZA y salida bOut0.
  // Cambiar de TCP no cambia fisicamente la herramienta.
  // Level 1 supone un piston en el punto ensenado; no espera bIn0.
  cycleStep = 40
  putln("40 - Pick piston - tTip")
  gripperOpen = true
  delay(tTip.otime)
  movej(jPistonPick[0], tTip, mNomSpeed)
  waitEndMove()
  movel(jointToPoint(tTip, world, jPistonPick[1]), tTip, mInsertSpeed)
  waitEndMove()
  gripperOpen = false
  delay(tTip.ctime)
  movel(jointToPoint(tTip, world, jPistonPick[0]), tTip, mInsertSpeed)
  waitEndMove()

  // ============================================================
  // 50. INSERTAR EL PISTON Y SOLTARLO ANTES DE RETIRARSE
  // ============================================================
  // TODO SIMULACION: confirmar el orden [0]/[1] de gridpiston.
  // TODO FISICO: ajustar alineacion y profundidad de jPistonInsert[1].
  // Este movimiento es por posicion; no mide fuerza ni confirma montaje.
  cycleStep = 50
  putln("50 - Insert piston into cylinder")
  movej(jPistonInsert[0], tTip, mNomSpeed)
  waitEndMove()
  movel(jointToPoint(tTip, world, jPistonInsert[1]), tTip, mInsertSpeed)
  waitEndMove()
  gripperOpen = true
  delay(tTip.otime)
  movel(jointToPoint(tTip, world, jPistonInsert[0]), tTip, mInsertSpeed)
  waitEndMove()

  // ============================================================
  // 60. RECOGER EL CONJUNTO CON EL TCP LATERAL
  // ============================================================
  // Recoger en jCylinderPlace[1], donde se ha depositado el cilindro.
  // TODO FISICO: comprobar el agarre con el piston ya dentro del cilindro.
  cycleStep = 60
  putln("60 - Pick assembled cylinder - tLateral")
  gripperOpen = true
  delay(tLateral.otime)
  movej(jCylinderPlace[0], tLateral, mNomSpeed)
  waitEndMove()
  movel(jointToPoint(tLateral, world, jCylinderPlace[1]), tLateral, mInsertSpeed)
  waitEndMove()
  gripperOpen = false
  delay(tLateral.ctime)
  movel(jointToPoint(tLateral, world, jCylinderPlace[0]), tLateral, mInsertSpeed)
  waitEndMove()

  // ============================================================
  // 70. DEPOSITAR EL CONJUNTO EN LA RAMPA Y RETIRARSE
  // ============================================================
  cycleStep = 70
  putln("70 - Place assembly on final ramp")
  movej(jRampPlace[0], tLateral, mNomSpeed)
  waitEndMove()
  movel(jointToPoint(tLateral, world, jRampPlace[1]), tLateral, mInsertSpeed)
  waitEndMove()
  gripperOpen = true
  delay(tLateral.otime)
  movel(jointToPoint(tLateral, world, jRampPlace[0]), tLateral, mInsertSpeed)
  waitEndMove()

  // ============================================================
  // 100. FIN DE UN SOLO CICLO
  // ============================================================
  // No hay retorno automatico a jStart ni repeticion/alimentacion.
  // La ultima orden de pinza queda aplicada al terminar el adaptador.
  taskKill("physicalIO")
  ioReady = false
  cycleStep = 100
  putln("100 - Level 1 sequence completed")
end
</code>
    </source>
  </program>
</programList>
