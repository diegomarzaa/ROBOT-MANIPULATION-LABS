<?xml version="1.0" encoding="utf-8"?>
<programList xmlns="ProgramNameSpace">
  <program name="moveCylinder" public="false">
    <description>Prepared after recovery; validate taught poses and trajectories in simulation.</description>
    <paramSection />
    <localSection />
    <source>
      <code>begin
  putln("Opening gripper")
  open(tLateral)
  putln("Moving to transit posture")
  movej(jTransCylinder, tLateral, mNomSpeed)
  waitEndMove()
  putln("Approaching cylinder")
  movej(pCylApproach, tLateral, mNomSpeed)
  waitEndMove()
  putln("Picking cylinder")
  movel(pCylPick, tLateral, mNomSpeed)
  waitEndMove()
  close(tLateral)
  putln("Withdrawing from dispenser")
  movel(pCylApproach, tLateral, mNomSpeed)
  waitEndMove()
  putln("Approaching assembly station")
  movej(pAsmApproach, tLateral, mNomSpeed)
  waitEndMove()
  putln("Placing cylinder")
  movel(pAsmCylinder, tLateral, mNomSpeed)
  waitEndMove()
  open(tLateral)
  putln("Withdrawing from assembly station")
  movel(pAsmApproach, tLateral, mNomSpeed)
  waitEndMove()
  putln("Cylinder transfer completed")
end
</code>
    </source>
  </program>
</programList>