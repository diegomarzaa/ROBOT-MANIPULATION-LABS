begin
  putln("2/3 - Pick and insert piston")
  open(tTip)
  movej(pPistonApproach, tTip, mNomSpeed)
  waitEndMove()
  movel(pPistonPick, tTip, mInsertSpeed)
  waitEndMove()
  close(tTip)
  movel(pPistonApproach, tTip, mInsertSpeed)
  waitEndMove()
  movej(pInsertApproach, tTip, mNomSpeed)
  waitEndMove()
  movel(pInsert, tTip, mInsertSpeed)
  waitEndMove()
  open(tTip)
  movel(pInsertApproach, tTip, mInsertSpeed)
  waitEndMove()
end
