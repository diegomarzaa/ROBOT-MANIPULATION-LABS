<?xml version="1.0" encoding="utf-8"?>
<programList xmlns="ProgramNameSpace">
  <program name="pickAndPlace" public="false">
    <description>Reusable pickup/place sequence. Material 0 non-metallic; 1 metallic.</description>
    <paramSection />
    <localSection />
    <source>
      <code>begin
  // ============================================================
  // RECOGER Y COLOCAR UNA PIEZA
  // ============================================================
  // Esta rutina se reutiliza para todas las piezas.
  //
  // materialType=0: recoger de la rampa no metalica.
  // materialType=1: recoger de la rampa metalica.
  //
  // placeIndex indica el destino de la matriz: 0..7.


  // ============================================================
  // 1. IR A LA APROXIMACION DE RECOGIDA
  // ============================================================
  // Empezamos con aspiracion y soplado apagados.
  vacuumOn = false
  blowOn = false

  // Ir a la posicion situada sobre la recogida correspondiente.
  // movej no obliga al TCP a seguir una linea recta.
  movej(pickApproach[materialType], vacuumTool, moveSpeed)
  waitEndMove()


  // ============================================================
  // 2. ENTRAR LINEALMENTE HASTA LA PIEZA
  // ============================================================
  // pickPose esta guardada como joints.
  // jointToPoint calcula el punto cartesiano equivalente
  // porque movel necesita un objetivo cartesiano.
  // Al utilizar movel, el TCP sigue una linea recta.
  movel(jointToPoint(vacuumTool, world, pickPose[materialType]), vacuumTool, moveSpeed)
  waitEndMove()


  // ============================================================
  // FASE 60: ACTIVAR ASPIRACION Y CONFIRMAR EL AGARRE
  // ============================================================
  // vacuumOn es la ORDEN de aspirar.
  // partOnTool es la CONFIRMACION de pieza en la ventosa.
  // Mantenerlo true durante el traslado.
  vacuumOn = true
  cycleStep = 60
  putln("60 - Wait: partOnTool=true; keep true during transfer")
  wait(partOnTool == true)


  // ============================================================
  // 3. SALIR LINEALMENTE DE LA ZONA DE RECOGIDA
  // ============================================================
  movel(jointToPoint(vacuumTool, world, pickApproach[materialType]), vacuumTool, moveSpeed)
  waitEndMove()


  // ============================================================
  // 4. TRASLADAR LA PIEZA HASTA ENCIMA DE SU DESTINO
  // ============================================================
  // placeIndex ya calculado.
  movej(placeApproach[placeIndex], vacuumTool, moveSpeed)
  waitEndMove()


  // ============================================================
  // 5. ENTRAR LINEALMENTE HASTA LA POSICION DE DEPOSITO
  // ============================================================
  // Desde la aproximacion entramos en linea recta al hueco.
  // Esperamos a llegar antes de cortar la aspiracion.
  movel(jointToPoint(vacuumTool, world, placePose[placeIndex]), vacuumTool, moveSpeed)
  waitEndMove()


  // ============================================================
  // 6. SOLTAR LA PIEZA
  // ============================================================
  // Primero dejamos de aspirar.
  // Despues aplicamos un soplado breve para ayudar a separarla.
  vacuumOn = false
  blowOn = true
  delay(0.3)
  blowOn = false


  // ============================================================
  // FASE 70: CONFIRMAR QUE LA PIEZA YA NO ESTA EN LA VENTOSA
  // ============================================================
  // En fisico esperamos que bIn0 deje de detectar pieza.
  //
  // SIMULACION: solo al llegar a esta fase,
  // cambiar partOnTool=false.
  cycleStep = 70
  putln("70 - Wait: partOnTool=false")

  wait(partOnTool == false)


  // ============================================================
  // 7. RETIRARSE DEL HUECO Y VOLVER A HOME
  // ============================================================
  // Primero salimos linealmente hasta la aproximacion.
  // Despues volvemos a la posicion inicial mediante movej.
  movel(jointToPoint(vacuumTool, world, placeApproach[placeIndex]), vacuumTool, moveSpeed)
  waitEndMove()

  movej(homePose, vacuumTool, moveSpeed)
  waitEndMove()

  // Al terminar, regresamos a start.
  // Alli se incrementa el contador del material colocado.

end</code>
    </source>
  </program>
</programList>