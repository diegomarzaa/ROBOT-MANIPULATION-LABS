<?xml version='1.0' encoding='UTF-8'?>
<programList xmlns="ProgramNameSpace">
  <program name="physicalIO" public="false">
    <description>Lab2A Level 3 - shared manual simulation / physical cycle</description>
    <paramSection/>
    <localSection/>
    <source>
      <code>begin
      
  // Background I/O bridge (runs only when simulation=false).
  // Polls hardware inputs and updates physical outputs every 10 ms

  while true
    // SENSORS

    partOnTool  = (io:bIn0 == true)   // Vacuum pressure sensor on tool. Confirms vaccum.
    partAtClass = (io:bIn1 == true)   // Presence sensor at classification gate
    partIsMetal = (io:bIn2 == true)   // Inductive sensor (true = metallic)
    partAtRamp  = (io:bIn4 == true)   // Presence sensor at ramp exit
    
    //ACTUATORS

    io:bOut0 = vacuumOn               // Suction valve
    io:bOut1 = blowOn                 // Blow-off release valve    

    io:bOut2 = trolleyOn              // Conveyor belt motor
    io:bOut3 = nonMetalGate           // Diverter 1 (non-metallic ramp)
    io:bOut4 = metalGate              // Diverter 2 (metallic ramp)
    io:bOut5 = !barrierClosed         // Retaining barrier (INVERSE LOGIC)


    ioReady = true                    // Signal start() that first I/O scan is done
    delay(0.01)

  endWhile
end</code>
    </source>
  </program>
</programList>
