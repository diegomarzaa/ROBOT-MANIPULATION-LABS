<?xml version='1.0' encoding='UTF-8'?>
<programList xmlns="ProgramNameSpace">
  <program name="physicalIO" public="false">
    <description>Lab2A Level 3 - shared manual simulation / physical cycle</description>
    <paramSection/>
    <localSection/>
    <source>
      <code>begin
  // ============================================================
  // ADAPTADOR ENTRE LAS VARIABLES Y LOS PINES FISICOS
  // ============================================================
  // start solo crea esta tarea cuando simulation=false.
  //
  // Trabaja en paralelo con el ciclo principal:
  // 1. Lee entradas reales y actualiza nuestros sensores bool.
  // 2. Lee nuestras ordenes bool y las escribe en salidas reales.
  // 3. Hace una pausa breve y repite.
  //
  // Asi, un wait del programa principal puede desbloquearse
  // cuando esta tarea detecta un cambio en un sensor real.
  //
  // En fisico NO modificar los sensores bool a mano:
  // esta tarea los sobrescribe con las lecturas reales.
  while true
    // ==========================================================
    // 1. LEER LOS SENSORES DE PIEZA
    // ==========================================================
    // Cada comparacion convierte la lectura de la entrada
    // en un valor bool: true si esta activa, false si no.

    // bIn0: confirma que hay una pieza en la ventosa.
    // No es la orden de aspiracion, sino su confirmacion.
    partOnTool = io:bIn0 == true

    // bIn1: confirma presencia en la zona de clasificacion.
    partAtClass = io:bIn1 == true

    // bIn2: detector inductivo.
    // Activo significa metalica.
    // Inactivo se interpreta como no metalica SOLO cuando
    // sabemos que hay una pieza en clasificacion.
    partIsMetal = io:bIn2 == true

    // bIn3 no se usa: esperamos directamente presencia en clasificacion.

    // bIn4: detecta el paso de una pieza por la rampa.
    // No confirma que ya haya llegado al punto de recogida.
    partAtRamp = io:bIn4 == true


    // bIn5..bIn8 no se usan en esta version simplificada.
    // Los desviadores reciben su orden y damos un tiempo fijo.

    // ==========================================================
    // 3. APLICAR LAS ORDENES DE LA VENTOSA
    // ==========================================================
    // El programa principal cambia vacuumOn y blowOn.
    // Aqui convertimos esas variables en salidas fisicas.

    // bOut0: activar o desactivar la aspiracion.
    io:bOut0 = vacuumOn

    // bOut1: activar o desactivar el soplado.
    io:bOut1 = blowOn


    // ==========================================================
    // 4. APLICAR LAS ORDENES DE ALIMENTACION Y CLASIFICACION
    // ==========================================================

    // bOut2: orden al carro de alimentacion.
    io:bOut2 = trolleyOn

    // bOut3: actuador 1, asociado a las no metalicas.
    // TODO FISICO: confirmar que true significa empujar.
    io:bOut3 = nonMetalGate

    // bOut4: actuador 2, asociado a las metalicas.
    // TODO FISICO: confirmar que true significa empujar.
    io:bOut4 = metalGate

    // bOut5: barrera de retencion.
    // Polaridad invertida: retener=true envia bOut5=0.
    // Liberar=false envia bOut5=1; pendiente comprobar en fisico.
    io:bOut5 = !barrierClosed


    // ==========================================================
    // 5. AVISAR DE QUE LA PRIMERA ACTUALIZACION ESTA HECHA
    // ==========================================================
    // start espera esta variable antes de continuar en fisico.
    // Una vez pasa a true, permanece true durante la ejecucion.
    ioReady = true

    // Pausa de 0.01 segundos antes de repetir las lecturas.
    // No garantiza un periodo exacto de 10 ms: tambien cuenta
    // el tiempo empleado en ejecutar y planificar la tarea.
    delay(0.01)

  endWhile
end</code>
    </source>
  </program>
</programList>
