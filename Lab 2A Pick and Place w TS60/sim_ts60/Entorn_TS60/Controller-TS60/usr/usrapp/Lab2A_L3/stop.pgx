<?xml version='1.0' encoding='UTF-8'?>
<programList xmlns="ProgramNameSpace">
  <program name="stop" public="false">
    <description>Lab2A Level 3 - shared manual simulation / physical cycle</description>
    <paramSection/>
    <localSection/>
    <source>
      <code>begin

  // Stop motion and feeding; preserve suction.
  resetMotion()

  trolleyOn = false
  barrierClosed = true
  blowOn = false

  if physicalRun
    taskKill("physicalIO")
    io:bOut2 = false
    io:bOut1 = false
    io:bOut5 = false
  endIf

  cycleStep = -1
  putln("Application stopped safely.")
  resetMotion()

end
</code>
    </source>
  </program>
</programList>
