<?xml version='1.0' encoding='UTF-8'?>
<programList xmlns="ProgramNameSpace">
  <program name="feedPart" public="false">
    <description>Physical station sequence preserved in comments; not called during motion simulation.</description>
    <paramSection/>
    <localSection/>
    <source>
      <code>begin
  // Not called in motion simulation. Restore the PHYSICAL body for the real station.
  // PHYSICAL | bCycleOK = false
  // PHYSICAL | bOut2 = false
  // PHYSICAL | bOut5 = true
  // PHYSICAL | putln("Waiting for a source part")
  // PHYSICAL | 
  // PHYSICAL | if bIn1 == true or bIn4 == true
  // PHYSICAL | putln("ERROR: classification path not clear")
  // PHYSICAL | return
  // PHYSICAL | endIf
  // PHYSICAL | if !watch(bIn3 == true, 10)
  // PHYSICAL | putln("ERROR: source empty or sensor timeout")
  // PHYSICAL | return
  // PHYSICAL | endIf
  // PHYSICAL | 
  // PHYSICAL | bOut2 = true
  // PHYSICAL | if !watch(bIn1 == true, 10)
  // PHYSICAL | bOut2 = false
  // PHYSICAL | putln("ERROR: part did not reach classification")
  // PHYSICAL | return
  // PHYSICAL | endIf
  // PHYSICAL | bOut2 = false
  // PHYSICAL | // Initial sensor-settling interval; validate on the station.
  // PHYSICAL | delay(0.1)
  // PHYSICAL | if bIn1 == false
  // PHYSICAL | putln("ERROR: classification presence lost")
  // PHYSICAL | return
  // PHYSICAL | endIf
  // PHYSICAL | if bIn2 == true
  // PHYSICAL | nType = 1
  // PHYSICAL | putln("Metallic part")
  // PHYSICAL | else
  // PHYSICAL | nType = 0
  // PHYSICAL | putln("Non-metallic part")
  // PHYSICAL | endIf
  // PHYSICAL | if nCount[nType] &gt;= 4
  // PHYSICAL | putln("ERROR: material row full; part retained at barrier")
  // PHYSICAL | return
  // PHYSICAL | endIf
  // PHYSICAL | 
  // PHYSICAL | // Fixed mapping: 1 extends; actuator 1 -&gt; non-metal, actuator 2 -&gt; metal.
  // PHYSICAL | if nType == 0
  // PHYSICAL | bOut3 = true
  // PHYSICAL | bOut4 = false
  // PHYSICAL | if !watch(bIn5 == true and bIn6 == false and bIn7 == false and bIn8 == true, 10)
  // PHYSICAL | putln("ERROR: non-metallic route not confirmed")
  // PHYSICAL | return
  // PHYSICAL | endIf
  // PHYSICAL | else
  // PHYSICAL | bOut3 = false
  // PHYSICAL | bOut4 = true
  // PHYSICAL | if !watch(bIn5 == false and bIn6 == true and bIn7 == true and bIn8 == false, 10)
  // PHYSICAL | putln("ERROR: metallic route not confirmed")
  // PHYSICAL | return
  // PHYSICAL | endIf
  // PHYSICAL | endIf
  // PHYSICAL | if bIn4 == true
  // PHYSICAL | putln("ERROR: ramp sensor already active")
  // PHYSICAL | return
  // PHYSICAL | endIf
  // PHYSICAL | 
  // PHYSICAL | // Fixed assumption: output 5 = 1 holds; 0 releases.
  // PHYSICAL | // Validate that this transfer passes exactly one part on this station.
  // PHYSICAL | bOut5 = false
  // PHYSICAL | bOut2 = true
  // PHYSICAL | if !watch(bIn4 == true, 10)
  // PHYSICAL | bOut2 = false
  // PHYSICAL | bOut5 = true
  // PHYSICAL | putln("ERROR: no ramp passage detected")
  // PHYSICAL | return
  // PHYSICAL | endIf
  // PHYSICAL | bOut2 = false
  // PHYSICAL | bOut5 = true
  // PHYSICAL | if !watch(bIn4 == false, 10)
  // PHYSICAL | putln("ERROR: ramp passage sensor remained active")
  // PHYSICAL | return
  // PHYSICAL | endIf
  // PHYSICAL | if bIn1 == true
  // PHYSICAL | putln("ERROR: classification still occupied after transfer")
  // PHYSICAL | return
  // PHYSICAL | endIf
  // PHYSICAL | delay(0.5)
  // PHYSICAL | bCycleOK = true
end
</code>
    </source>
  </program>
</programList>
