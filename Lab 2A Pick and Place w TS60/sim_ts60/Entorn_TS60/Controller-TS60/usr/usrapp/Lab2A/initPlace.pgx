<?xml version='1.0' encoding='UTF-8'?>
<programList xmlns="ProgramNameSpace">
  <program name="initPlace" public="false">
    <description>Generate 2x4 joint destinations and approaches using the controller FK/IK. No motion.</description>
    <paramSection/>
    <localSection>
      <local name="nRow" type="num" size="1"/>
      <local name="nCol" type="num" size="1"/>
      <local name="nIndex" type="num" size="1"/>
      <local name="pTarget" type="pointRs" size="1"/>
    </localSection>
    <source>
      <code>begin
  bCycleOK = false
  // Anchor pPlace[0] is the user-taught joint. No fMatrix is used.
  // Use two rows of the CAD plate: 4 columns at 60 mm, rows 70 mm apart.
  // Selected corner: columns follow CAD -X; rows follow CAD +Y.
  // In the saved robot world, those directions are -Y and -X respectively.
  for nRow = 0 to 1
    for nCol = 0 to 3
      nIndex = 4*nRow + nCol
      pTarget = jointToPoint(tTool, world, pPlace[0])
      pTarget.trsf.x = pTarget.trsf.x - 70*nRow
      pTarget.trsf.y = pTarget.trsf.y - 60*nCol

      if nIndex != 0
        if !pointToJoint(tTool, pPlace[0], pTarget, pPlace[nIndex])
          putln("ERROR: cannot solve matrix joint")
          putln(nIndex)
          return
        endIf
      endIf

      pTarget.trsf.z = pTarget.trsf.z + 50
      if !pointToJoint(tTool, pPlace[nIndex], pTarget, pApproachPlace[nIndex])
        putln("ERROR: cannot solve approach joint")
        putln(nIndex)
        return
      endIf
    endFor
  endFor
  bCycleOK = true
end
</code>
    </source>
  </program>
</programList>
