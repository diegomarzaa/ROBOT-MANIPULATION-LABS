# Copiar como .gitignore en la raiz de ROBOT-MANIPULATION-LABS.
# Archivos del sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Copias y temporales
*.bak
*.tmp
*.temp
~$*

# Logs de ejecucion del emulador/controlador
*.log

# Preferencias personales de SRS (ventanas, watches, aplicacion seleccionada)
*.cuo

# No ignorar .pgx, .pjx, .dtx, .ltx, .cell, .controller, .kxml,
# .wrl, simulation.xml, .cf, .cfx ni las carpetas sys/ y usr/.
# Se conserva Layouts/ y la miniatura PNG inicial de la celda.